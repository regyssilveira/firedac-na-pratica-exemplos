{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "examples"],
  "properties": {
    "schemaVersion": {"const": 1},
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "chapter", "title", "status", "evidence"],
        "properties": {
          "id": {"pattern": "^EX-[0-9]{2}-[0-9]{2}$"},
          "chapter": {"type": "integer", "minimum": 1, "maximum": 21},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["PL", "IM", "CP", "EX", "RV"]},
          "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
